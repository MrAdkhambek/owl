@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if (APPLE AND NOT OPENSSL_ROOT_DIR)
    execute_process(
            COMMAND brew --prefix openssl@3
            OUTPUT_VARIABLE OPENSSL_ROOT_DIR
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
    )
endif ()

find_dependency(Threads)
find_dependency(OpenSSL)
find_dependency(ZLIB)
find_dependency(nlohmann_json)

find_package(PkgConfig REQUIRED)
pkg_check_modules(H2O REQUIRED IMPORTED_TARGET libh2o-evloop)
pkg_check_modules(WSLAY REQUIRED IMPORTED_TARGET libwslay)

set_and_check(owl_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

if (NOT TARGET owl::fstr)
    add_library(owl::fstr INTERFACE IMPORTED)
    set_target_properties(owl::fstr PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${owl_INCLUDE_DIR}"
            INTERFACE_COMPILE_FEATURES cxx_std_23)
endif ()

if (NOT TARGET owl::coro)
    add_library(owl::coro INTERFACE IMPORTED)
    set_target_properties(owl::coro PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${owl_INCLUDE_DIR}"
            INTERFACE_COMPILE_FEATURES cxx_std_23
            INTERFACE_LINK_LIBRARIES Threads::Threads)
endif ()

if (NOT TARGET owl::owl)
    add_library(owl::owl INTERFACE IMPORTED)
    set_target_properties(owl::owl PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${owl_INCLUDE_DIR}"
            INTERFACE_COMPILE_FEATURES cxx_std_23
            INTERFACE_COMPILE_DEFINITIONS H2O_USE_LIBUV=0
            INTERFACE_LINK_LIBRARIES "owl::coro;owl::fstr;PkgConfig::H2O;PkgConfig::WSLAY;nlohmann_json::nlohmann_json;OpenSSL::SSL;OpenSSL::Crypto;ZLIB::ZLIB")
    endif ()

if (@OWL_ENABLE_PROMETHEUS@)
    # Installed owl::owl carries the same optional dependency the build-tree
    # target has: dispatch records HTTP RED under OWL_ENABLE_PROMETHEUS.
    set_property(TARGET owl::owl APPEND PROPERTY
            INTERFACE_COMPILE_DEFINITIONS OWL_ENABLE_PROMETHEUS)
    set_property(TARGET owl::owl APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES owl::prometheus)

    if (NOT TARGET owl::prometheus)
        add_library(owl::prometheus INTERFACE IMPORTED)
        set_target_properties(owl::prometheus PROPERTIES
                INTERFACE_INCLUDE_DIRECTORIES "${owl_INCLUDE_DIR}"
                INTERFACE_COMPILE_FEATURES cxx_std_23
                INTERFACE_LINK_LIBRARIES "")
    endif ()
endif ()

if (@OWL_ENABLE_SQLITE@ OR @OWL_ENABLE_POSTGRESQL@)
    # owl::sql mirrors the build-tree tiers; owl::owl links it just as in
    # the build tree, and the OWL_ENABLE_* macros ride on the driver
    # targets.
    if (NOT TARGET owl::sql_core)
        add_library(owl::sql_core INTERFACE IMPORTED)
        set_target_properties(owl::sql_core PROPERTIES
                INTERFACE_INCLUDE_DIRECTORIES "${owl_INCLUDE_DIR}"
                INTERFACE_COMPILE_FEATURES cxx_std_23
                INTERFACE_LINK_LIBRARIES "owl::coro;owl::fstr")
    endif ()

    if (@OWL_ENABLE_SQLITE@)
        find_dependency(SQLite3)
        if (NOT TARGET owl::sql_sqlite)
            add_library(owl::sql_sqlite INTERFACE IMPORTED)
            set_target_properties(owl::sql_sqlite PROPERTIES
                    INTERFACE_INCLUDE_DIRECTORIES "${owl_INCLUDE_DIR}"
                    INTERFACE_COMPILE_FEATURES cxx_std_23
                    INTERFACE_COMPILE_DEFINITIONS OWL_ENABLE_SQLITE
                    INTERFACE_LINK_LIBRARIES "owl::sql_core;SQLite::SQLite3")
        endif ()
    endif ()

    if (@OWL_ENABLE_POSTGRESQL@)
        find_package(PkgConfig REQUIRED)
        pkg_check_modules(PQ REQUIRED IMPORTED_TARGET libpq)
        if (NOT TARGET owl::sql_psql)
            add_library(owl::sql_psql INTERFACE IMPORTED)
            set_target_properties(owl::sql_psql PROPERTIES
                    INTERFACE_INCLUDE_DIRECTORIES "${owl_INCLUDE_DIR}"
                    INTERFACE_COMPILE_FEATURES cxx_std_23
                    INTERFACE_COMPILE_DEFINITIONS OWL_ENABLE_POSTGRESQL
                    INTERFACE_LINK_LIBRARIES "owl::sql_core;PkgConfig::PQ")
        endif ()
    endif ()

    if (NOT TARGET owl::sql)
        add_library(owl::sql INTERFACE IMPORTED)
        set_target_properties(owl::sql PROPERTIES
                INTERFACE_INCLUDE_DIRECTORIES "${owl_INCLUDE_DIR}"
                INTERFACE_COMPILE_FEATURES cxx_std_23
                INTERFACE_LINK_LIBRARIES "owl::sql_core$<IF:$<BOOL:@OWL_ENABLE_SQLITE@>,;owl::sql_sqlite,>$<IF:$<BOOL:@OWL_ENABLE_POSTGRESQL@>,;owl::sql_psql,>")
    endif ()
    set_property(TARGET owl::owl APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES owl::sql)
endif ()
